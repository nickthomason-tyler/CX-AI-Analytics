<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS config for the Foundry analytics dashboard.

  The pages contain named users and verbatim complaint text, so access is
  Windows-authenticated and restricted to ONE group. Replace DOMAIN\GROUP below
  before going live -- until you do, nobody can get in (fails closed).

  Prerequisite (once, per server): Server Manager > Add Roles and Features >
  Web Server > Security > Windows Authentication.
-->
<configuration>
  <system.webServer>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
      <authorization>
        <remove users="*" roles="" verbs="" />
        <add accessType="Allow" roles="DOMAIN\GROUP" />
      </authorization>
    </security>

    <defaultDocument enabled="true">
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- A refreshed dashboard must not keep showing yesterday's numbers. -->
        <add name="Cache-Control" value="no-cache, must-revalidate" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
